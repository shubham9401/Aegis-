# Public testnet configuration. Deployment refuses all chains except 10143.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
IDENTITY_REGISTRY_ADDRESS=0x8004A818BFB912233c491871b3d84c89A494BD9e
# Keep the encrypted JSON keystore OUTSIDE this repository. Do not paste secrets in chat.
# Deployment prompts for its password with hidden input.
DEPLOYER_KEYSTORE_PATH=
# Optional standard ERC-20 address. If blank, deploys clearly labelled 6-decimal test USD.
PAYMENT_TOKEN_ADDRESS=
# Optional public deployer address lets preflight check the balance without a keystore.
DEPLOYER_ADDRESS=
