# Server-only secrets. Generate separate random values.
VAULT_SERVER_KEY=
AEGIS_DEMO_AGENT_TOKEN=
# Shared token is bound to this exact agent label, not an ERC-8004 proof.
AEGIS_AGENT_ID=
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.6

# Local persistent disk; use one long-lived server process.
# AEGIS_DATA_DIR=/absolute/private/data-directory
# Vercel Functions require a shared store. Connect Upstash Redis to the
# Vercel project and configure these server-only values for each environment.
# AEGIS_STORAGE_BACKEND=redis
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
AEGIS_APP_ORIGIN=http://localhost:3000

# Use `demo` for local policy state or `contract` for live Monad read enforcement.
NEXT_PUBLIC_ADAPTER=demo
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Existing deployment; change only when intentionally switching contracts.
AEGIS_CONTRACT_ADDRESS=0xeDB8F11c9b6F67ba1D51a4cEdc5151D41e4Bfdb3
# Current ERC-8004 owner address for the numeric AEGIS_AGENT_ID.
AEGIS_AGENT_ADDRESS=
# Agent demo only: path to this agent owner's encrypted JSON keystore, outside Git.
AEGIS_AGENT_KEYSTORE_PATH=
# Opaque random bytes32 used by the grant and the vault encryption binding.
AEGIS_RESOURCE_SCOPE=

# Demo merchant public recipient shown in the grant form.
AEGIS_MERCHANT_ADDRESS=
