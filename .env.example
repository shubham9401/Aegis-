# Create .env.local beside this file and paste a newly generated key there.
# Never commit or share the real value.
KIMI_API_KEY=replace_with_new_kimi_api_key
KIMI_MODEL=kimi-k2.6

# Connected agent demo. Keep the token private and server-side.
AEGIS_WEB_URL=http://localhost:3000
AEGIS_DEMO_AGENT_TOKEN=replace_with_a_random_demo_token
AEGIS_USER=0x1111111111111111111111111111111111111111
AEGIS_AGENT_ID=erc8004:monad:travel-agent-001
AEGIS_PERMISSION_ID=replace_with_the_permission_id_from_the_dashboard
